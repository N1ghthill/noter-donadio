{
  "name": "@noter/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @noter/contracts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:outbox": "node dist/outbox.main.js",
    "start:realtime": "node dist/realtime.main.js",
    "start:transcription": "node dist/transcription.main.js",
    "start:analysis": "node dist/analysis.main.js",
    "start:notification": "node dist/notification.main.js",
    "start:retention": "node dist/media-retention.main.js",
    "start:media-download": "node dist/media-download.main.js",
    "start:baileys": "node dist/baileys.main.js",
    "bootstrap:admin": "node dist/bootstrap-admin.js",
    "reset:admin-password": "node dist/reset-admin-password.js",
    "finalize:workspace": "node dist/finalize-workspace.js",
    "seed:demo": "node dist/seed-demo.js",
    "pretypecheck": "npm run build -w @noter/contracts",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@noter/contracts": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "baileys": "7.0.0-rc13",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "openai": "^7.31.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4"
  }
}
