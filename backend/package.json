{
  "name": "@noter/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "npm run build -w @noter/contracts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:outbox": "node dist/outbox.main.js",
    "bootstrap:admin": "node dist/bootstrap-admin.js",
    "seed:demo": "node dist/seed-demo.js",
    "pretypecheck": "npm run build -w @noter/contracts",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "npm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@noter/contracts": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bullmq": "^5.80.9",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "pg": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "^7.9.0"
  }
}
