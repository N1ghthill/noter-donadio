generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ContactSource {
  whatsapp_auto
  manual
  import
}

enum ContactStatus {
  active
  archived
  blocked
}

enum NegotiationStage {
  lead
  qualified
  proposal_sent
  in_negotiation
  on_hold
  closed_won
  closed_lost
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  audio
  image
  video
  document
  system_note
}

enum ProcessingState {
  pending
  processing
  completed
  failed
}

enum Sentiment {
  positive
  neutral
  negative
  urgent
}

enum OutboxStatus {
  pending
  processing
  published
  failed
}

enum WhatsappConnectionStatus {
  disconnected
  qr_generated
  connecting
  connected
  timeout
}

enum UserRole {
  admin
}

enum UserStatus {
  active
  disabled
}

enum AnalysisDecisionKind {
  accepted
  ignored
}

enum AuditAction {
  contact_created
  contact_updated
  contact_deleted
  contact_merged
  negotiation_created
  negotiation_updated
  negotiation_stage_changed
  negotiation_follow_up_completed
  analysis_accepted
  analysis_ignored
  workspace_exported
  whatsapp_auth_reset
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  whatsappAccounts           WhatsappAccount[]
  whatsappAuthKeys           WhatsappAuthKey[]
  contacts                   Contact[]
  negotiations               Negotiation[]
  messages                   Message[]
  mediaAssets                MediaAsset[]
  aiAnalyses                 AiAnalysis[]
  outboxEvents               OutboxEvent[]
  users                      User[]
  analysisDecisions          AnalysisDecision[]
  auditEvents                AuditEvent[]
  mediaDeletionTasks         MediaDeletionTask[]
  negotiationFollowUpHistory NegotiationFollowUpHistory[]

  @@map("workspaces")
}

model User {
  id                            String                       @id @default(uuid()) @db.Uuid
  workspaceId                   String                       @map("workspace_id") @db.Uuid
  email                         String                       @db.VarChar(320)
  displayName                   String                       @map("display_name") @db.VarChar(255)
  passwordHash                  String                       @map("password_hash") @db.VarChar(512)
  role                          UserRole                     @default(admin)
  status                        UserStatus                   @default(active)
  lastLoginAt                   DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  createdAt                     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions                      Session[]
  analysisDecisions             AnalysisDecision[]
  auditEvents                   AuditEvent[]
  completedNegotiationFollowUps NegotiationFollowUpHistory[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [workspaceId, userId], references: [workspaceId, id], onDelete: Cascade)

  @@index([tokenHash, expiresAt])
  @@index([userId, revokedAt])
  @@map("sessions")
}

model WhatsappAccount {
  id                        String                   @id @default(uuid()) @db.Uuid
  workspaceId               String                   @map("workspace_id") @db.Uuid
  identifier                String                   @db.VarChar(100)
  phoneNumber               String?                  @map("phone_number") @db.VarChar(20)
  provider                  String?                  @db.VarChar(50)
  providerBusinessAccountId String?                  @map("provider_business_account_id") @db.VarChar(255)
  providerPhoneNumberId     String?                  @map("provider_phone_number_id") @db.VarChar(255)
  connectionStatus          WhatsappConnectionStatus @default(disconnected) @map("connection_status")
  lastConnectedAt           DateTime?                @map("last_connected_at") @db.Timestamptz(6)
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                 Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages                  Message[]
  authKeys                  WhatsappAuthKey[]

  @@unique([workspaceId, identifier])
  @@unique([workspaceId, id])
  @@unique([provider, providerPhoneNumberId])
  @@index([workspaceId])
  @@map("whatsapp_accounts")
}

model WhatsappAuthKey {
  id                   String          @id @default(uuid()) @db.Uuid
  workspaceId          String          @map("workspace_id") @db.Uuid
  accountId            String          @map("account_id") @db.Uuid
  category             String          @db.VarChar(100)
  keyId                String          @map("key_id") @db.VarChar(255)
  encryptedData        Bytes           @map("encrypted_data")
  iv                   Bytes
  authTag              Bytes           @map("auth_tag")
  encryptionKeyVersion Int             @default(1) @map("encryption_key_version") @db.SmallInt
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account              WhatsappAccount @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([accountId, category, keyId])
  @@index([workspaceId, accountId])
  @@map("whatsapp_auth_keys")
}

model Contact {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  jid               String?       @db.VarChar(255)
  phoneNumber       String        @map("phone_number") @db.VarChar(20)
  displayName       String        @default("Novo Contato") @map("display_name") @db.VarChar(255)
  profilePictureUrl String?       @map("profile_picture_url")
  tags              String[]      @default([])
  notes             String?
  source            ContactSource @default(whatsapp_auto)
  status            ContactStatus @default(active)
  metadata          Json          @default("{}")
  lastInteractionAt DateTime?     @map("last_interaction_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  negotiations      Negotiation[]
  messages          Message[]
  auditEvents       AuditEvent[]

  @@unique([workspaceId, jid])
  @@unique([workspaceId, id])
  @@index([workspaceId, phoneNumber])
  @@index([workspaceId, status])
  @@index([tags], type: Gin)
  @@map("contacts")
}

model Negotiation {
  id                           String                       @id @default(uuid()) @db.Uuid
  workspaceId                  String                       @map("workspace_id") @db.Uuid
  contactId                    String                       @map("contact_id") @db.Uuid
  title                        String?                      @db.VarChar(255)
  stage                        NegotiationStage             @default(lead)
  value                        Decimal?                     @db.Decimal(15, 2)
  valueConfirmedAt             DateTime?                    @map("value_confirmed_at") @db.Timestamptz(6)
  currency                     String                       @default("BRL") @db.Char(3)
  expectedCloseDate            DateTime?                    @map("expected_close_date") @db.Date
  expectedCloseDateConfirmedAt DateTime?                    @map("expected_close_date_confirmed_at") @db.Timestamptz(6)
  productInterest              String?                      @map("product_interest")
  productInterestConfirmedAt   DateTime?                    @map("product_interest_confirmed_at") @db.Timestamptz(6)
  nextAction                   String?                      @map("next_action")
  nextActionConfirmedAt        DateTime?                    @map("next_action_confirmed_at") @db.Timestamptz(6)
  nextActionDueDate            DateTime?                    @map("next_action_due_date") @db.Date
  nextActionDueDateConfirmedAt DateTime?                    @map("next_action_due_date_confirmed_at") @db.Timestamptz(6)
  lastSummary                  String?                      @map("last_summary")
  sentiment                    Sentiment?
  priority                     Int                          @default(0) @db.SmallInt
  pipelineStageOrder           Int                          @default(0) @map("pipeline_stage_order")
  metadata                     Json                         @default("{}")
  closedAt                     DateTime?                    @map("closed_at") @db.Timestamptz(6)
  closeReason                  String?                      @map("close_reason")
  version                      Int                          @default(1)
  createdAt                    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact                      Contact                      @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  messages                     Message[]
  aiAnalyses                   AiAnalysis[]
  analysisDecisions            AnalysisDecision[]
  auditEvents                  AuditEvent[]
  followUpHistory              NegotiationFollowUpHistory[]

  @@unique([workspaceId, id])
  @@index([workspaceId, stage])
  @@index([workspaceId, nextActionDueDate])
  @@index([contactId])
  @@index([workspaceId, priority])
  @@map("negotiations")
}

model NegotiationFollowUpHistory {
  id                String      @id @default(uuid()) @db.Uuid
  workspaceId       String      @map("workspace_id") @db.Uuid
  negotiationId     String      @map("negotiation_id") @db.Uuid
  completedByUserId String      @map("completed_by_user_id") @db.Uuid
  description       String
  dueDate           DateTime?   @map("due_date") @db.Date
  completedAt       DateTime    @default(now()) @map("completed_at") @db.Timestamptz(6)
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  negotiation       Negotiation @relation(fields: [workspaceId, negotiationId], references: [workspaceId, id], onDelete: Cascade)
  completedByUser   User        @relation(fields: [workspaceId, completedByUserId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, completedAt])
  @@index([negotiationId, completedAt])
  @@map("negotiation_follow_up_history")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  workspaceId       String           @map("workspace_id") @db.Uuid
  whatsappAccountId String           @map("whatsapp_account_id") @db.Uuid
  externalMessageId String           @map("external_message_id") @db.VarChar(255)
  contactId         String           @map("contact_id") @db.Uuid
  negotiationId     String?          @map("negotiation_id") @db.Uuid
  direction         MessageDirection
  messageType       MessageType      @map("message_type")
  content           String?
  contentHash       String?          @map("content_hash") @db.Char(64)
  occurredAt        DateTime         @map("occurred_at") @db.Timestamptz(6)
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  whatsappAccount   WhatsappAccount  @relation(fields: [workspaceId, whatsappAccountId], references: [workspaceId, id], onDelete: Cascade)
  contact           Contact          @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  negotiation       Negotiation?     @relation(fields: [workspaceId, negotiationId], references: [workspaceId, id], onDelete: Restrict)
  mediaAsset        MediaAsset?
  aiAnalyses        AiAnalysis[]

  @@unique([whatsappAccountId, externalMessageId])
  @@unique([workspaceId, id])
  @@index([workspaceId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([negotiationId, occurredAt])
  @@map("messages")
}

model MediaAsset {
  id                      String          @id @default(uuid()) @db.Uuid
  workspaceId             String          @map("workspace_id") @db.Uuid
  messageId               String          @unique @map("message_id") @db.Uuid
  storageKey              String?         @map("storage_key") @db.VarChar(500)
  externalMediaId         String?         @map("external_media_id") @db.VarChar(255)
  encryptedProviderReference Bytes?       @map("encrypted_provider_reference")
  providerReferenceIv        Bytes?       @map("provider_reference_iv")
  providerReferenceAuthTag   Bytes?       @map("provider_reference_auth_tag")
  providerReferenceKeyVersion Int?        @map("provider_reference_key_version") @db.SmallInt
  fileSizeBytes           BigInt?         @map("file_size_bytes")
  durationSeconds         Int?            @map("duration_seconds")
  mimeType                String?         @map("mime_type") @db.VarChar(100)
  originalFileName        String?         @map("original_file_name") @db.VarChar(255)
  downloadState           ProcessingState @default(completed) @map("download_state")
  downloadAttemptId       String?         @map("download_attempt_id") @db.Uuid
  downloadStartedAt       DateTime?       @map("download_started_at") @db.Timestamptz(6)
  downloadFailureCode     String?         @map("download_failure_code") @db.VarChar(100)
  transcriptionState      ProcessingState @default(pending) @map("transcription_state")
  transcriptionAttemptId  String?         @map("transcription_attempt_id") @db.Uuid
  processingStartedAt     DateTime?       @map("processing_started_at") @db.Timestamptz(6)
  transcriptionText       String?         @map("transcription_text")
  transcriptionConfidence Decimal?        @map("transcription_confidence") @db.Decimal(5, 4)
  transcriptionLanguage   String?         @map("transcription_language") @db.VarChar(10)
  transcriptionModel      String?         @map("transcription_model") @db.VarChar(100)
  failureCode             String?         @map("failure_code") @db.VarChar(100)
  retentionUntil          DateTime?       @map("retention_until") @db.Timestamptz(6)
  removedAt               DateTime?       @map("removed_at") @db.Timestamptz(6)
  transcribedAt           DateTime?       @map("transcribed_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message                 Message         @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, messageId])
  @@index([workspaceId, downloadState])
  @@index([workspaceId, transcriptionState])
  @@index([transcriptionState, processingStartedAt])
  @@index([retentionUntil, removedAt])
  @@map("media_assets")
}

model MediaDeletionTask {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  storageKey  String    @unique @map("storage_key") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("media_deletion_tasks")
}

model AiAnalysis {
  id                  String            @id @default(uuid()) @db.Uuid
  workspaceId         String            @map("workspace_id") @db.Uuid
  messageId           String            @map("message_id") @db.Uuid
  negotiationId       String            @map("negotiation_id") @db.Uuid
  analysisType        String            @default("message_extraction") @map("analysis_type") @db.VarChar(50)
  state               ProcessingState   @default(pending)
  analysisAttemptId   String?           @map("analysis_attempt_id") @db.Uuid
  processingStartedAt DateTime?         @map("processing_started_at") @db.Timestamptz(6)
  summary             String?
  entities            Json?
  sentiment           Sentiment?
  sentimentConfidence Decimal?          @map("sentiment_confidence") @db.Decimal(5, 4)
  objections          String[]          @default([])
  nextActions         String[]          @default([]) @map("next_actions")
  suggestedTags       String[]          @default([]) @map("suggested_tags")
  suggestedStage      NegotiationStage? @map("suggested_stage")
  confidenceScore     Decimal?          @map("confidence_score") @db.Decimal(5, 4)
  promptVersion       String            @map("prompt_version") @db.VarChar(100)
  promptTokens        Int?              @map("prompt_tokens")
  completionTokens    Int?              @map("completion_tokens")
  modelUsed           String?           @map("model_used") @db.VarChar(100)
  processingTimeMs    Int?              @map("processing_time_ms")
  failureCode         String?           @map("failure_code") @db.VarChar(100)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message             Message           @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)
  negotiation         Negotiation       @relation(fields: [workspaceId, negotiationId], references: [workspaceId, id], onDelete: Cascade)
  decision            AnalysisDecision?

  @@unique([workspaceId, id])
  @@unique([messageId, analysisType, promptVersion])
  @@index([workspaceId, state])
  @@index([state, processingStartedAt])
  @@index([negotiationId, createdAt])
  @@map("ai_analyses")
}

model AnalysisDecision {
  id                          String               @id @db.Uuid
  workspaceId                 String               @map("workspace_id") @db.Uuid
  analysisId                  String               @unique @map("analysis_id") @db.Uuid
  negotiationId               String               @map("negotiation_id") @db.Uuid
  userId                      String               @map("user_id") @db.Uuid
  decision                    AnalysisDecisionKind
  appliedStage                NegotiationStage?    @map("applied_stage")
  appliedTags                 String[]             @default([]) @map("applied_tags")
  appliedValue                Decimal?             @map("applied_value") @db.Decimal(15, 2)
  appliedExpectedCloseDate    DateTime?            @map("applied_expected_close_date") @db.Date
  appliedProductInterest      String?              @map("applied_product_interest")
  appliedNextAction           String?              @map("applied_next_action")
  appliedNextActionDueDate    DateTime?            @map("applied_next_action_due_date") @db.Date
  resultingNegotiationVersion Int                  @map("resulting_negotiation_version")
  createdAt                   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace                   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis                    AiAnalysis           @relation(fields: [workspaceId, analysisId], references: [workspaceId, id], onDelete: Cascade)
  negotiation                 Negotiation          @relation(fields: [workspaceId, negotiationId], references: [workspaceId, id], onDelete: Cascade)
  user                        User                 @relation(fields: [workspaceId, userId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@unique([workspaceId, analysisId])
  @@index([workspaceId, createdAt])
  @@index([negotiationId, createdAt])
  @@map("analysis_decisions")
}

model AuditEvent {
  id               String       @id @default(uuid()) @db.Uuid
  workspaceId      String       @map("workspace_id") @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  contactId        String?      @map("contact_id") @db.Uuid
  negotiationId    String?      @map("negotiation_id") @db.Uuid
  action           AuditAction
  changedFields    String[]     @default([]) @map("changed_fields")
  previousVersion  Int?         @map("previous_version")
  resultingVersion Int?         @map("resulting_version")
  details          Json         @default("{}")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [workspaceId, userId], references: [workspaceId, id], onDelete: Restrict)
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  negotiation      Negotiation? @relation(fields: [negotiationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([contactId, createdAt])
  @@index([negotiationId, createdAt])
  @@map("audit_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  lastErrorCode String?      @map("last_error_code") @db.VarChar(100)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([workspaceId, createdAt])
  @@map("outbox_events")
}
