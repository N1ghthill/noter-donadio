# Ambiente local. Copie para .env e substitua os valores.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

DATABASE_URL=postgresql://noter:noter_local_only@127.0.0.1:5432/noter_donadio
DB_USER=noter
DB_PASSWORD=noter_local_only
REDIS_URL=redis://127.0.0.1:6379
INTERNAL_INGESTION_TOKEN=replace-with-at-least-32-random-characters
WHATSAPP_ADAPTER=fake
TRANSCRIPTION_ADAPTER=fake
AI_ADAPTER=fake
MEDIA_STORAGE_PATH=storage/media
MEDIA_SIGNING_SECRET=replace-with-at-least-32-random-characters
MEDIA_RETENTION_DAYS=30
MEDIA_MAX_BYTES=10485760
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use somente durante o bootstrap e remova ADMIN_PASSWORD em seguida.
ADMIN_WORKSPACE_SLUG=noter-donadio
ADMIN_WORKSPACE_NAME=noter.donadio
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Administrador
ADMIN_PASSWORD=

# Adicione apenas quando os respectivos adapters forem habilitados.
OPENAI_API_KEY=
BAILEYS_ENCRYPTION_KEY=
